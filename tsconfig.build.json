{
  "extends": "./tsconfig",
  "compilerOptions": {
    "declaration": true,
    "skipLibCheck": true,
    "jsx": "react",
    "lib": ["esnext", "dom"],
    "types": ["react", "react-native"],
    "typeRoots": ["./types", "./node_modules/@types"]
  },
  "include": ["src", "types"],
  "exclude": ["src/__tests__/**", "**/*.test.ts", "**/*.test.tsx"]
}
